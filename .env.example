# Chat / gRPC
GRPC_ADDR=0.0.0.0:50051
GRPC_PORT=50051
GRPCUI_PORT=8080
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ports
CRM_SERVER_PORT=3000
STORE_PORT=3001
PORT=3001

# App URLs
NODE_ENV=production
LOG_LEVELS=error,warn
SERVER_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CRM_URL=http://localhost:3000

# Database (matches twentycrm/twenty-postgres:latest defaults)
PG_DATABASE_URL=postgres://twenty:twenty@postgres:5432/twenty

# Storage
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=/app/packages/twenty-server/.local-storage

# Redis
REDIS_URL=redis://redis:6379

# Secrets (change these before any real/shared use)
APP_SECRET=change-me-app-secret-please-change-in-production-123456
ENCRYPTION_KEY=change-me-encryption-key-please-change-in-production
ACCESS_TOKEN_SECRET=change-me-access-token-secret-please-change-in-production
LOGIN_TOKEN_SECRET=change-me-login-token-secret-please-change-in-production
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret-please-change-in-production
FILE_TOKEN_SECRET=change-me-file-token-secret-please-change-in-production

# Auth (auto-pre-fills the sign-in form when the seeded admin user exists)
SIGN_IN_PREFILLED=true

# Auto-seed credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Owner
ADMIN_JOB_TITLE=Owner
WORKSPACE_NAME=Potato Merch
